{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/discord/interactions",
      "destination": "/api/discord/interactions"
    },
    {
      "source": "/api/discord/cron",
      "destination": "/api/cron?platform=discord"
    },
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/telegram/webhook"
    },
    {
      "source": "/api/telegram/cron",
      "destination": "/api/cron?platform=telegram"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron"
    },
    {
      "source": "/api/results/:path*",
      "destination": "/api/results"
    },
    {
      "source": "/api/results",
      "destination": "/api/results"
    },
    {
      "source": "/api/discord/:path*",
      "destination": "/api/discord/router?subpath=:path*"
    },
    {
      "source": "/api/discord",
      "destination": "/api/discord/router"
    },
    {
      "source": "/api/telegram/:path*",
      "destination": "/api/telegram/router?subpath=:path*"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram/router"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
