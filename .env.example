# =========================================================================
# DEVARENA – VERCEL SERVERLESS ZERO-DATABASE PRODUCTION ENVIRONMENT CONFIG
# =========================================================================
# In this database-free architecture, challenges are deterministically chosen
# from the static DSA dataset using Day-of-Year calendar math.
# Server-side secrets are used for Discord HTTP interactions and Telegram webhooks.
# No Supabase, PostgreSQL, or external databases are required.

# -------------------------------------------------------------------------
# 1. DISCORD BOT CREDENTIALS (Server-Side Only - Never prefix with VITE_)
# -------------------------------------------------------------------------
# Discord Developer Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=1571437524746899537
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_PUBLIC_KEY=6603211a4512284a6d8332ee758411588d09307895836a6bdb2540239a9f162c
DISCORD_REDIRECT_URI=https://devarena-ten.vercel.app/app/connect

# Optional: Comma-separated channel IDs to broadcast scheduled challenges via Vercel Cron
# Example: 119284729104829104,119284729104829105
DISCORD_BROADCAST_CHANNELS=

# -------------------------------------------------------------------------
# 2. TELEGRAM BOT CREDENTIALS (Server-Side Only - Never prefix with VITE_)
# -------------------------------------------------------------------------
# Official Bot: @DEVARENA_CommunityBot (via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Secret token used by Telegram Bot API when sending webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_SECRET_TOKEN=your_secure_telegram_webhook_secret_here

# Optional: Comma-separated chat IDs to broadcast scheduled challenges via Vercel Cron
# Example: -1001928374829,-1001849204820
TELEGRAM_BROADCAST_CHATS=

# -------------------------------------------------------------------------
# 3. VERCEL CRON SECURITY
# -------------------------------------------------------------------------
# Secures the /api/cron, /api/discord/cron, and /api/telegram/cron endpoints.
# Vercel sends this automatically in the Authorization: Bearer <CRON_SECRET> header.
CRON_SECRET=your_secure_cron_secret_token

# -------------------------------------------------------------------------
# 4. APP BASE URL
# -------------------------------------------------------------------------
VITE_APP_URL=https://devarena-ten.vercel.app
