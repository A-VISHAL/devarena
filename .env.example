# =========================================================================
# DEVARENA CONNECT – Discord Bot & Backend Environment Configuration
# =========================================================================

# Discord Developer Portal Credentials (https://discord.com/developers/applications)
# 1. Create a Discord Application
# 2. Add a Bot under the 'Bot' tab and enable 'Message Content Intent' & 'Server Members Intent' if needed
# 3. Under 'OAuth2' -> 'General', copy Client ID and Client Secret
# 4. Under 'General Information', copy Public Key for slash commands webhook verification

DISCORD_CLIENT_ID=1571437524746899537
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_PUBLIC_KEY=6603211a4512284a6d8332ee758411588d09307895836a6bdb2540239a9f162c

# Discord Redirect URI (must be added in Discord Developer Portal -> OAuth2 -> Redirects)
# Production: https://devarena.io/app/connect
# Local Dev: http://localhost:4173/app/connect or http://localhost:5173/app/connect
DISCORD_REDIRECT_URI=https://devarena.io/app/connect

# Optional: Supabase Database Configuration (if using cloud PostgreSQL)
# Run SQL migration in supabase/migrations/20261115_discord_integration.sql
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Vercel Cron Secret (for securing /api/discord/cron)
CRON_SECRET=your_secure_cron_secret_token

